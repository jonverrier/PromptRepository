{
  "name": "@jonverrier/prompt-repository",
  "version": "0.3.21",
  "description": "Managing Prompts and standardised Unit Evals ",
  "main": "dist/src/entry.js",
  "types": "dist/src/entry.d.ts",
  "directories": {
    "src": "src",
    "test": "test"
  },
  "files": [
    "dist/src/**/*",
    "LICENSE",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jonverrier/PromptRepository.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "author": "Jon Verrier",
  "license": "MIT",
  "scripts": {
    "start": "ts-node entry.ts",
    "build": "tsc -b",
    "prepublishOnly": "npm run build",
    "dev": "npm run build && npm run watch",
    "make_prompt_ids": "ts-node scripts/MakePromptIds.ts",
    "watch": "tsc -b -w",
    "clean": "rimraf dist",
    "test": "jest --selectProjects unit",
    "test:ci": "jest --selectProjects ci",
    "test:integration": "jest --selectProjects integration",
    "test:mini": "jest --selectProjects mini",
    "link-local": "bash scripts/link-local.sh",
    "unlink-local": "bash scripts/unlink-local.sh",
    "link-status": "bash scripts/link-status.sh",
    "verify-main": "bash scripts/verify-main.sh",
    "pre-commit-check": "bash scripts/pre-commit-check.sh",
    "pre-push-check": "bash scripts/pre-push-check.sh",
    "cover": "jest --selectProjects unit --coverage --coverageReporters=html text lcov",
    "cover:json": "jest --selectProjects unit --coverage --coverageReporters=json --coverageDirectory=.nyc_output"
  },
  "dependencies": {
    "@jonverrier/assistant-common": "^0.3.3"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@google/generative-ai": "^0.21.0",
    "openai": "^6.8.1"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@google/generative-ai": "^0.21.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.0.10",
    "expect": "^29.7.0",
    "jest": "^29.7.0",
    "openai": "^6.8.1",
    "rimraf": "^6.0.1",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tslib": "^2.8.1",
    "typescript": "5.9.3"
  }
}
